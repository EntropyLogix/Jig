#!/bin/sh
set -u

SELF_DIR=$(cd "$(dirname "$0")" && pwd)
CREW="$SELF_DIR/crew"
case $CREW in
    "$HOME"/*) CREW="~${CREW#"$HOME"}" ;;
esac
SKILL_DIR=$(cd "$SELF_DIR/.." && pwd)

usage() {
    cat <<'EOF'
Usage:
  crew dev ID LABEL                     developer: implement or fix the issue
  crew audit ID LABEL [--cross-check]   auditor: audit the current review round
  crew audit ID --lead                  lead auditor: merge the round into a decision
  crew architect ID                     architect: turn a proposal into a contract
  crew status ID                        list review rounds, reports, and decisions
  crew fingerprint                      print the code fingerprint for a handoff

LABEL names the agent (letters, digits, '.', '_', '-'), e.g. claude-dev.
Run crew inside the project that holds the Billet registry.
EOF
}

refuse() {
    printf 'crew: %s\n' "$1" >&2
    shift
    for line in "$@"; do
        printf '%s\n' "$line" >&2
    done
    exit 2
}

need() {
    for tool in blt jq git; do
        command -v "$tool" >/dev/null 2>&1 || refuse "$tool is required but not installed"
    done
}

check_label() {
    case $1 in
        '' | .* | *[!A-Za-z0-9._-]*)
            refuse "invalid label \"$1\": use letters, digits, '.', '_' or '-'"
            ;;
    esac
}

round_name() {
    printf 'round-%02d' "$1"
}

find_root() {
    dir=$PWD
    while :; do
        if [ -d "$dir/.blt" ]; then
            printf '%s\n' "$dir"
            return 0
        fi
        [ "$dir" = / ] && return 1
        dir=$(dirname "$dir")
    done
}

load() {
    info=$(blt show "$1" --json) || exit 2
    ID=$(printf '%s' "$info" | jq -r '.id')
    STATUS=$(printf '%s' "$info" | jq -r '.status')
    ASSIGNEE=$(printf '%s' "$info" | jq -r '.assignee // ""')
    DOCS=$(printf '%s' "$info" | jq -r '.docs_dir')
    DOCS=${DOCS%/}
    PARENT=$(printf '%s' "$info" | jq -r '.parent // ""')
    NOTES=$(printf '%s' "$info" | jq -r '.notes')
    history=$(printf '%s' "$info" | jq -r '.history')
    ROUNDS=$(printf '%s\n' "$history" | grep -c '^- [^ ]* [^ ]* UTC submitted for review' || true)
    LAST_EVENT=$(printf '%s\n' "$history" |
        grep -E '^- [^ ]* [^ ]* UTC (submitted for review|rework requested|reopened)' |
        tail -n 1 |
        sed -E 's/^- [^ ]* [^ ]* UTC //')
    ROOT=$(find_root) || refuse "no .blt registry found above $PWD"
}

escape() {
    printf '%s' "$1" | sed 's/[\\|&]/\\&/g'
}

render() {
    sed -e "s|{{ID}}|$(escape "$ID")|g" \
        -e "s|{{ROUND}}|$(escape "$ROUND")|g" \
        -e "s|{{LABEL}}|$(escape "$LABEL")|g" \
        -e "s|{{CREW}}|$(escape "$CREW")|g" \
        -e "s|{{DOCS}}|$(escape "$DOCS")|g" \
        -e "s|{{HANDOFF}}|$(escape "$HANDOFF")|g" \
        -e "s|{{REPORT}}|$(escape "$REPORT")|g" \
        -e "s|{{DECISION}}|$(escape "$DECISION")|g" \
        -e "s|{{PREVIOUS}}|$(escape "$PREVIOUS")|g" \
        -e "s|{{ARCHITECTURE}}|$(escape "$ARCHITECTURE_DOC")|g" \
        "$1"
}

create() {
    if [ -e "$ROOT/$2" ]; then
        printf 'existing'
    else
        mkdir -p "$(dirname "$ROOT/$2")"
        render "$SKILL_DIR/templates/$1" >"$ROOT/$2"
        printf 'created'
    fi
}

verdict() {
    found=$(awk '/^## Verdict[[:space:]]*$/ { on = 1; next } on && /^## / { exit } on && NF { print; exit }' "$1")
    case $found in
        '' | 'changes needed | accepted') printf 'in progress' ;;
        *) printf '%s' "$found" ;;
    esac
}

described() {
    if [ "$1" = existing ]; then
        printf 'existing, verdict: %s' "$(verdict "$2")"
    else
        printf '%s' "$1"
    fi
}

modified() {
    date -r "$1" '+%Y-%m-%d %H:%M'
}

fingerprint() {
    top=$(git rev-parse --show-toplevel 2>/dev/null) || refuse "not inside a git repository"
    cd "$top" || exit 2
    head=$(git rev-parse --verify -q HEAD) || head=none
    base=$head
    [ "$head" = none ] && base=$(git hash-object -t tree /dev/null)
    exclude=':(glob,exclude)**/.blt/**'
    diff=$(git diff --binary "$base" -- . "$exclude" | git hash-object --stdin)
    untracked=$(git ls-files -z --others --exclude-standard -- . "$exclude" |
        tr '\0' '\n' |
        while IFS= read -r path; do
            printf '%s %s\n' "$(git hash-object -- "$path")" "$path"
        done |
        git hash-object --stdin)
    printf 'HEAD %s diff %s untracked %s\n' "$head" "$(printf '%s' "$diff" | cut -c1-12)" \
        "$(printf '%s' "$untracked" | cut -c1-12)"
}

code_state() {
    if [ ! -f "$ROOT/$HANDOFF" ]; then
        printf 'WARNING: %s is missing; the developer did not hand over this round.' "$HANDOFF"
        return
    fi
    recorded=$(grep '^Fingerprint: HEAD ' "$ROOT/$HANDOFF" | tail -n 1 | sed 's/^Fingerprint: //')
    if [ -z "$recorded" ]; then
        printf 'WARNING: the handoff has no fingerprint; the audited code state is unknown.'
        return
    fi
    current=$(cd "$ROOT" && fingerprint)
    if [ "$recorded" = "$current" ]; then
        printf 'matches the handoff (%s)' "$current"
    else
        printf 'WARNING: CHANGED since the handoff.\n  handoff: %s\n  now:     %s' "$recorded" "$current"
    fi
}

architect_note() {
    printf '%s\n' "$1" | grep '^- [^ ]* [^ ]* UTC architect: ' | tail -n 1 | sed -E 's/^- ([^ ]* [^ ]*) UTC architect: /\1: /'
}

lineage() {
    ARCHITECTURES=
    ARCHITECT=
    [ -f "$ROOT/$DOCS/architecture.md" ] && ARCHITECTURES="$DOCS/architecture.md (architecture)"
    note=$(architect_note "$NOTES")
    [ -n "$note" ] && ARCHITECT="$ID $note"
    ancestor=$PARENT
    while [ -n "$ancestor" ]; do
        ancestor_info=$(blt show "$ancestor" --json 2>/dev/null) || break
        ancestor_docs=$(printf '%s' "$ancestor_info" | jq -r '.docs_dir')
        ancestor_docs=${ancestor_docs%/}
        if [ -f "$ROOT/$ancestor_docs/architecture.md" ]; then
            entry="$ancestor_docs/architecture.md (architecture of $ancestor)"
            if [ -n "$ARCHITECTURES" ]; then
                ARCHITECTURES="$ARCHITECTURES
$entry"
            else
                ARCHITECTURES=$entry
            fi
        fi
        if [ -z "$ARCHITECT" ]; then
            note=$(architect_note "$(printf '%s' "$ancestor_info" | jq -r '.notes')")
            [ -n "$note" ] && ARCHITECT="$ancestor $note"
        fi
        ancestor=$(printf '%s' "$ancestor_info" | jq -r '.parent // ""')
    done
}

print_architectures() {
    [ -n "$ARCHITECTURES" ] || return 0
    printf '%s\n' "$ARCHITECTURES" | while IFS= read -r line; do
        printf '       %s\n' "$line"
    done
}

header() {
    printf 'Role:  %s\n' "$1"
    printf 'Issue: %s (%s)\n' "$ID" "$STATUS"
    [ -n "$ROUND" ] && printf 'Round: %s\n' "$ROUND"
    printf 'Root:  %s (paths below are relative to it)\n' "$ROOT"
}

instructions() {
    printf '\n--- instructions ---\n\n'
    for file in "$@"; do
        render "$SKILL_DIR/roles/$file"
        printf '\n'
    done
}

PREVIOUS=none
ARCHITECTURE_DOC=none
ROUND=
HANDOFF=none
REPORT=none
DECISION=none

role_dev() {
    [ $# -eq 2 ] || refuse "usage: crew dev ID LABEL" "Give the developer a label, e.g. claude-dev."
    LABEL=$2
    check_label "$LABEL"
    load "$1"
    case $STATUS in
        open)
            claimed=$(blt claim "$ID" --by "$LABEL") || exit 2
            load "$ID"
            ;;
        claimed) ;;
        review)
            refuse "$ID is in review: the code is frozen until the lead returns it with rework." \
                "Wait for the decision of $(round_name "$ROUNDS")."
            ;;
        proposed)
            refuse "$ID is proposed: a person approves it first (blt approve $ID)."
            ;;
        *)
            refuse "$ID is $STATUS: there is no work to do."
            ;;
    esac
    if [ -z "$ASSIGNEE" ]; then
        refuse "$ID is claimed without a label." \
            "A person decides whether to take it over: blt unclaim $ID, then run crew again."
    fi
    if [ "$ASSIGNEE" != "$LABEL" ]; then
        refuse "$ID is claimed by $ASSIGNEE, not by $LABEL."
    fi
    ROUND=$(printf '%02d' $((ROUNDS + 1)))
    HANDOFF="$DOCS/review/round-$ROUND/handoff.md"
    case $LAST_EVENT in
        'rework requested'*)
            MODE=fixes
            DECISION="$DOCS/review/$(round_name "$ROUNDS")/decision.md"
            [ -f "$ROOT/$DECISION" ] || DECISION="none (read the rework reason in blt show $ID)"
            ;;
        *)
            MODE=new
            ;;
    esac
    state=$(create handoff.md "$HANDOFF")
    lineage
    header "developer ($LABEL)"
    [ -n "${claimed:-}" ] && printf 'Claim: %s\n' "$claimed"
    if [ -n "$ARCHITECT" ]; then
        printf 'Architect: reviewed (%s)\n' "$ARCHITECT"
    else
        printf 'Architect: not reviewed\n'
    fi
    if [ "$MODE" = fixes ]; then
        printf 'Mode:  fixes after %s\n' "$(round_name "$ROUNDS")"
        printf 'Read:  %s\n' "$DECISION"
        printf '       blt show %s (the contract)\n' "$ID"
    else
        printf 'Mode:  new work\n'
        printf 'Read:  blt show %s (the contract)\n' "$ID"
    fi
    print_architectures
    printf 'Write: %s (%s)\n' "$HANDOFF" "$state"
    instructions common.md dev.md
}

role_audit() {
    if [ $# -eq 2 ] && [ "$2" = --lead ]; then
        role_lead "$1"
        return
    fi
    cross=no
    [ $# -eq 3 ] && [ "$3" = --cross-check ] && cross=yes
    if [ $# -ne 2 ] && [ "$cross" = no ]; then
        refuse "usage: crew audit ID LABEL [--cross-check] | crew audit ID --lead" "Give the auditor a label, e.g. codex-audit."
    fi
    LABEL=$2
    check_label "$LABEL"
    case $LABEL in
        lead | architect) refuse "the label $LABEL is reserved for its role" ;;
    esac
    load "$1"
    [ "$STATUS" = review ] ||
        refuse "$ID is $STATUS: there is nothing to audit (an issue is audited while it is in review)."
    ROUND=$(printf '%02d' "$ROUNDS")
    dir="$DOCS/review/round-$ROUND"
    HANDOFF="$dir/handoff.md"
    DECISION="$dir/decision.md"
    REPORT="$dir/audit-$LABEL.md"
    if [ "$cross" = yes ] && [ ! -f "$ROOT/$DECISION" ]; then
        refuse "round $ROUND has no decision.md yet: a cross-check reviews the lead's decision."
    fi
    if [ "$ROUNDS" -gt 1 ]; then
        PREVIOUS="$DOCS/review/$(round_name $((ROUNDS - 1)))/decision.md"
        [ -f "$ROOT/$PREVIOUS" ] || PREVIOUS=none
    fi
    state=$(create audit.md "$REPORT")
    lineage
    if [ "$cross" = yes ]; then
        header "auditor ($LABEL), cross-check"
    else
        header "auditor ($LABEL)"
    fi
    printf 'Code:  %s\n' "$(code_state)"
    printf 'Read:  blt show %s (the contract)\n' "$ID"
    print_architectures
    printf '       %s\n' "$HANDOFF"
    [ "$PREVIOUS" != none ] && printf '       %s (previous decision)\n' "$PREVIOUS"
    if [ "$cross" = yes ]; then
        printf '       %s\n' "$DECISION"
        for other in "$ROOT/$dir"/audit-*.md; do
            [ -f "$other" ] || continue
            [ "$other" = "$ROOT/$REPORT" ] && continue
            printf '       %s\n' "$dir/$(basename "$other")"
        done
    fi
    printf 'Write: %s (%s)\n' "$REPORT" "$(described "$state" "$ROOT/$REPORT")"
    if [ "$cross" = yes ]; then
        instructions common.md auditing.md cross-check.md
    else
        instructions common.md auditing.md audit.md
    fi
}

role_lead() {
    LABEL=lead
    load "$1"
    [ "$STATUS" = review ] ||
        refuse "$ID is $STATUS: a review round is led while the issue is in review."
    ROUND=$(printf '%02d' "$ROUNDS")
    dir="$DOCS/review/round-$ROUND"
    HANDOFF="$dir/handoff.md"
    REPORT="$dir/audit-lead.md"
    DECISION="$dir/decision.md"
    if [ "$ROUNDS" -gt 1 ]; then
        PREVIOUS="$DOCS/review/$(round_name $((ROUNDS - 1)))/decision.md"
        [ -f "$ROOT/$PREVIOUS" ] || PREVIOUS=none
    fi
    report_state=$(create audit.md "$REPORT")
    decision_state=$(create decision.md "$DECISION")
    lineage
    header "lead auditor"
    printf 'Code:  %s\n' "$(code_state)"
    printf 'Read:  blt show %s (the contract)\n' "$ID"
    print_architectures
    printf '       %s\n' "$HANDOFF"
    [ "$PREVIOUS" != none ] && printf '       %s (previous decision)\n' "$PREVIOUS"
    found=no
    for other in "$ROOT/$dir"/audit-*.md; do
        [ -f "$other" ] || continue
        [ "$other" = "$ROOT/$REPORT" ] && continue
        printf '       %s (auditor report)\n' "$dir/$(basename "$other")"
        found=yes
    done
    [ "$found" = no ] && printf '       (no auditor reports yet)\n'
    printf 'Write: %s (%s)\n' "$REPORT" "$(described "$report_state" "$ROOT/$REPORT")"
    printf '       %s (%s)\n' "$DECISION" "$(described "$decision_state" "$ROOT/$DECISION")"
    instructions common.md auditing.md lead.md
}

role_status() {
    [ $# -eq 1 ] || refuse "usage: crew status ID"
    load "$1"
    printf 'Issue: %s (%s' "$ID" "$STATUS"
    [ -n "$ASSIGNEE" ] && printf ', %s' "$ASSIGNEE"
    printf ')\n'
    if [ "$ROUNDS" -eq 0 ]; then
        printf 'No review rounds yet.\n'
        return
    fi
    n=1
    while [ "$n" -le "$ROUNDS" ]; do
        dir="$DOCS/review/$(round_name "$n")"
        printf '\nRound %02d: %s\n' "$n" "$dir"
        if [ -f "$ROOT/$dir/handoff.md" ]; then
            printf '  handoff: %s\n' "$(modified "$ROOT/$dir/handoff.md")"
        else
            printf '  handoff: missing\n'
        fi
        found=no
        for report in "$ROOT/$dir"/audit-*.md; do
            [ -f "$report" ] || continue
            label=$(basename "$report" .md)
            label=${label#audit-}
            printf '  report %s: %s, %s\n' "$label" "$(verdict "$report")" "$(modified "$report")"
            found=yes
        done
        [ "$found" = no ] && printf '  reports: none\n'
        if [ -f "$ROOT/$dir/decision.md" ]; then
            printf '  decision: %s, %s\n' "$(verdict "$ROOT/$dir/decision.md")" "$(modified "$ROOT/$dir/decision.md")"
        else
            printf '  decision: none\n'
        fi
        n=$((n + 1))
    done
}

role_architect() {
    [ $# -eq 1 ] || refuse "usage: crew architect ID"
    LABEL=architect
    load "$1"
    case $STATUS in
        proposed) ;;
        open)
            refuse "$ID is open: it is already approved for implementation." \
                "A person returns it for analysis with: blt revise $ID --reason TEXT"
            ;;
        *)
            refuse "$ID is $STATUS: the architect works on proposals, before implementation starts."
            ;;
    esac
    ARCHITECTURE_DOC="$DOCS/architecture.md"
    state=$(create architecture.md "$ARCHITECTURE_DOC")
    lineage
    header "architect"
    if [ -n "$ARCHITECT" ]; then
        printf 'Architect: earlier note (%s)\n' "$ARCHITECT"
    fi
    printf 'Read:  blt show %s (the proposal)\n' "$ID"
    printf '       blt tree %s (existing subtasks)\n' "$ID"
    printf '%s\n' "$ARCHITECTURES" | grep -v '^$' | grep -v -F -x "$ARCHITECTURE_DOC (architecture)" | while IFS= read -r line; do
        printf '       %s\n' "$line"
    done
    printf 'Write: %s (%s)\n' "$ARCHITECTURE_DOC" "$state"
    printf '       the description of %s (blt update %s --body -)\n' "$ID" "$ID"
    printf '       subtasks (blt add TITLE --parent %s --body TEXT) and blockers (blt dep add)\n' "$ID"
    instructions common.md architect.md
}

[ $# -ge 1 ] || {
    usage
    exit 0
}
command=$1
shift
case $command in
    -h | --help | help)
        usage
        ;;
    fingerprint)
        [ $# -eq 0 ] || refuse "usage: crew fingerprint"
        command -v git >/dev/null 2>&1 || refuse "git is required but not installed"
        fingerprint
        ;;
    dev)
        need
        role_dev "$@"
        ;;
    audit)
        need
        role_audit "$@"
        ;;
    architect)
        need
        role_architect "$@"
        ;;
    status)
        need
        role_status "$@"
        ;;
    *)
        usage >&2
        refuse "unknown role \"$command\""
        ;;
esac
